rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Public profiles. Created once, in the same batch as the username claim.
    // Email is deliberately NOT stored here (this doc is world-readable to signed-in
    // users); it lives only in Firebase Auth. Writing an email field is rejected.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && !('emailLower' in request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'bio', 'photoUrl']);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Username uniqueness claims. Create-only; a set on an existing doc is an update and is denied.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Chats: only participants may read/write.
    match /chats/{chatId} {
      allow read, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'unreadCount', 'muted', 'pinned', 'archived', 'participantNames']);

      // Messages inherit access from the parent chat's participants.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if false;
        allow delete: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Public keys for E2EE key exchange.
    match /publicKeys/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
