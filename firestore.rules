rules_version = '2';
// Compatibility rules: what is deployed while app versions 1.3.x and 1.4.x are both in use.
// Starts from the rules that were live on 2026-10-03 and only ADDS what current apps need:
//   * users/{uid}/fcmTokens  - push tokens (without this, no device can ever be sent a push)
//   * publicKeys/{uid}       - E2EE key exchange (without this, chats silently stay unencrypted)
//   * profile create without emailLower, and name/bio edits (current apps never store an email)
//   * message reactions      - each person may set or clear only their own
// Nothing that worked before is denied now. The stricter target rules are in firestore.rules.next;
// switch to them once nobody runs 1.3.x anymore.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Public profiles. Created once, in the same batch as the username claim.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        // Current apps keep the email out of this world-readable doc. Very old apps sent it,
        // so it is still accepted, but only if it is the caller's own address.
        && (!('emailLower' in request.resource.data)
            || request.resource.data.emailLower == request.auth.token.email.lower())
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'bio', 'photoUrl', 'headline', 'place', 'interests'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.get('bio', '') is string
        && request.resource.data.get('bio', '').size() <= 160
        && request.resource.data.get('photoUrl', '') is string
        && request.resource.data.get('photoUrl', '').size() <= 500
        && request.resource.data.get('headline', '') is string
        && request.resource.data.get('headline', '').size() <= 80
        && request.resource.data.get('place', '') is string
        && request.resource.data.get('place', '').size() <= 60
        && request.resource.data.get('interests', []) is list
        && request.resource.data.get('interests', []).size() <= 12;
      allow delete: if isSignedIn() && request.auth.uid == uid;

      // FCM push tokens: owner-only, never part of the public profile. Doc id = token.
      match /fcmTokens/{token} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && token.size() <= 4096
          && request.resource.data.keys().hasOnly(['createdAt', 'platform'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.platform == 'android';
      }
    }

    // Username uniqueness claims. Create-only; a set on an existing doc is an update and is denied.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Chats: only participants may read/write. (Unchanged from the live rules.)
    match /chats/{chatId} {
      allow read, update, delete: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;

      // Messages inherit access from the parent chat's participants.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // Only reactions may change, and only the caller's own entry.
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys()
               .hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
              || (request.resource.data.reactions[request.auth.uid] is string
                  && request.resource.data.reactions[request.auth.uid].size() > 0
                  && request.resource.data.reactions[request.auth.uid].size() <= 16));
        // Editing: only the sender may change the text, and only to a non-empty string (flagged edited).
        allow update: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 8000
          && request.resource.data.edited == true;
        allow delete: if isSignedIn()
          && resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // Shared journal feed. Readable by anyone signed in. A post is owned by its author, who may
    // create and delete it. Likes are a list of uids: any signed-in user may add or remove ONLY
    // their own uid from likedBy (nothing else about the post may change on such an update).
    match /journalPosts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.likedBy == []
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;

      // Like / unlike: only likedBy changes, and the net change is exactly the caller's own uid
      // being added or removed. Every other uid in the list must stay untouched.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy is list
        && (
          // Like: I wasn't in the old list, I'm the only addition, nothing removed.
          (!(request.auth.uid in resource.data.likedBy)
            && request.resource.data.likedBy.toSet()
                 == resource.data.likedBy.toSet().union([request.auth.uid].toSet()))
          ||
          // Unlike: I was in the old list, I'm the only removal, nothing added.
          (request.auth.uid in resource.data.likedBy
            && request.resource.data.likedBy.toSet()
                 == resource.data.likedBy.toSet().difference([request.auth.uid].toSet()))
        );

      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ===================== WEAVE primitives =====================

    // Moments replace posts. Readable by anyone signed in. Authored & deleted by their author.
    // Reactions are intent tags: any signed-in user may set/clear ONLY their own entry.
    match /moments/{momentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.reactions.size() == 0
        && request.resource.data.responseCount == 0
        && request.resource.data.createdAt == request.time;
      // Only the reactions map may change on update, and only the caller's own key within it.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions is map
        && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys()
             .hasOnly([request.auth.uid]);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Responses: anyone signed in may reply as themselves; authors may delete their own.
      match /responses/{responseId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Sessions: anyone signed in may read live sessions and join/leave (participant/listener
    // arrays). The host creates it and may end it. Join/leave may only touch the roster arrays.
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Host may change anything on their own session (e.g. end it).
        resource.data.hostId == request.auth.uid
        // Anyone may add/remove themselves from the participant/listener rosters only.
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participantIds', 'listenerIds'])
      );
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;

      // Session chat: anyone signed in who is in the session (participant or listener) may post.
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && (request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantIds
              || request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.listenerIds);
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // Circles: members may read; owner creates; join/leave edits membership only.
    match /circles/{circleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberIds', 'memberNames'])
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Spaces: discoverable by anyone signed in; join/leave edits membership & counts only.
    // Anyone signed in may create a space with themselves as the only member.
    match /spaces/{spaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberCount == 1;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberIds', 'memberCount', 'onlineCount']);
      allow delete: if false;
    }

    // Public keys for E2EE key exchange: anyone signed in may read, only the owner may write.
    match /publicKeys/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['publicKey', 'updatedAt'])
        && request.resource.data.publicKey is string
        && request.resource.data.publicKey.size() > 0
        && request.resource.data.publicKey.size() <= 1000;
      allow delete: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
