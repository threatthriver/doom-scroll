<?xml version="1.0" encoding="utf-8"?>
<!-- Hush: a glossy glass orb (violet to indigo, with a cyan glow rising from the bottom) and two
     small pill-shaped eyes. Built from layered circles so it stays crisp at every size and sits
     inside the 66dp adaptive-icon safe zone (the orb is 60dp across). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft cyan light spilling below the orb -->
    <path android:pathData="M54,74m-26,0a26,16 0 1,0 52,0a26,16 0 1,0 -52,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="74"
                android:gradientRadius="26">
                <item android:offset="0.0" android:color="#665FE9FF" />
                <item android:offset="1.0" android:color="#005FE9FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sphere body: lighter violet on top, deep indigo through the middle, blue toward the base -->
    <path android:pathData="M54,52m-30,0a30,30 0 1,0 60,0a30,30 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="22"
                android:endX="54"
                android:endY="82">
                <item android:offset="0.0" android:color="#FF8E86F7" />
                <item android:offset="0.3" android:color="#FF5147F2" />
                <item android:offset="0.62" android:color="#FF3A2DE0" />
                <item android:offset="0.88" android:color="#FF2F7BFF" />
                <item android:offset="1.0" android:color="#FF5FE9FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cyan glow inside the base of the sphere -->
    <path android:pathData="M54,52m-30,0a30,30 0 1,0 60,0a30,30 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="84"
                android:gradientRadius="30">
                <item android:offset="0.0" android:color="#CC7DF0FF" />
                <item android:offset="0.55" android:color="#405FE9FF" />
                <item android:offset="1.0" android:color="#005FE9FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass sheen near the top -->
    <path android:pathData="M54,52m-30,0a30,30 0 1,0 60,0a30,30 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="48"
                android:centerY="30"
                android:gradientRadius="22">
                <item android:offset="0.0" android:color="#66FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pale rim light around the glass -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="1.2"
        android:pathData="M54,52m-29.4,0a29.4,29.4 0 1,0 58.8,0a29.4,29.4 0 1,0 -58.8,0" />

    <!-- Eyes -->
    <path
        android:fillColor="#F5FFFFFF"
        android:pathData="M44.3,43.2a1.9,1.9 0 0,1 3.8,0v6.6a1.9,1.9 0 0,1 -3.8,0z" />
    <path
        android:fillColor="#F5FFFFFF"
        android:pathData="M59.9,43.2a1.9,1.9 0 0,1 3.8,0v6.6a1.9,1.9 0 0,1 -3.8,0z" />
</vector>
