<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing from this app is backed up to the cloud or copied to a new phone.
     Message keys live in the hardware keystore and can't be moved, so restoring the rest of the
     app's data onto another device would only leave it in a broken state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
