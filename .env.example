# Copy to .env (git-ignored) and fill in. Used by CI / local tooling, NOT checked in.
#
# Base64 of app/google-services.json. Store the real value as an encrypted CI secret.
# Generate with: ./scripts/encode-google-services.sh
GOOGLE_SERVICES_JSON_BASE64=

# Firebase project identifiers (informational / for CLI scripting).
FIREBASE_PROJECT_ID=your-project-id
